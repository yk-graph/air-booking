generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  DEPARTED
  ARRIVED
}

enum CabinClass {
  ECONOMY
  BUSINESS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SeatStatus {
  PENDING
  CONFIRMED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Account {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             Role      @default(USER)
  emailVerifiedAt  DateTime?
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // has many relations
  bookings         Booking[]
  sessions         Session[]
  tokens           Token[]
  // has one relation
  staff            Staff?
}

model Session {
  id          String   @id @default(cuid())
  accountId   String
  hashedToken String   @unique
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  // belongs to relation
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Token {
  id          String    @id @default(cuid())
  accountId   String
  type        TokenType
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  // belongs to relation
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
}

model Staff {
  id          String   @id @default(cuid())
  accountId   String   @unique
  staffNumber String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // belongs to relation
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Airport {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  city            String
  country         String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  // has many relations
  departingRoutes FlightMap[] @relation("routeOrigin")
  arrivingRoutes  FlightMap[] @relation("routeDestination")
}

model FlightMap {
  id                   String   @id @default(cuid())
  code                 String   @unique
  originAirportId      String
  destinationAirportId String
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // has many relations
  flights              Flight[]
  // belongs to relations
  originAirport        Airport  @relation("routeOrigin", fields: [originAirportId], references: [id])
  destinationAirport   Airport  @relation("routeDestination", fields: [destinationAirportId], references: [id])

  @@unique([originAirportId, destinationAirportId])
}

model Flight {
  id              String       @id @default(cuid())
  flightNumber    String
  flightMapId     String
  departureAt     DateTime
  arrivalAt       DateTime
  durationMinutes Int
  basePrice       Decimal      @db.Decimal(10, 2)
  status          FlightStatus @default(SCHEDULED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // has many relations
  seats           Seat[]
  tickets         Ticket[]
  // belongs to relation
  flightMap       FlightMap    @relation(fields: [flightMapId], references: [id])

  @@unique([flightNumber, departureAt])
  @@index([flightMapId])
}

model Seat {
  id         String     @id @default(cuid())
  flightId   String
  seatRow    Int
  seatColumn String
  cabinClass CabinClass @default(ECONOMY)
  status     SeatStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // has one relation
  ticket     Ticket?
  // belongs to relation
  flight     Flight     @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seatRow, seatColumn])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  accountId      String?
  contactEmail   String
  contactPhone   String?
  firstName      String
  lastName       String
  middleName     String?
  dateOfBirth    DateTime?
  nationality    String?
  passportNumber String?
  countryOfIssue String?
  dateOfIssue    DateTime?
  dateOfExpiry   DateTime?
  status         BookingStatus @default(PENDING)
  totalPrice     Decimal       @db.Decimal(10, 2)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // has many relations
  tickets        Ticket[]
  payments       Payment[]
  // belongs to relation
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
}

model Ticket {
  id        String   @id @default(cuid())
  flightId  String
  seatId    String   @unique
  bookingId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // belongs to relations
  flight    Flight   @relation(fields: [flightId], references: [id])
  seat      Seat     @relation(fields: [seatId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@index([bookingId])
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String
  stripeCheckoutSessionId String        @unique
  stripePaymentIntentId   String?       @unique
  amount                  Int
  currency                String        @default("cad")
  status                  PaymentStatus @default(PENDING)
  receiptUrl              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  // belongs to relation
  booking                 Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
