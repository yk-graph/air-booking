generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  DEPARTED
  ARRIVED
}

enum CabinClass {
  ECONOMY
  BUSINESS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SeatStatus {
  PENDING
  CONFIRMED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Account {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // has many relations
  bookings        Booking[]
  sessions        Session[]
  tokens          Token[]
  // has one relation
  staff           Staff?
}

model Session {
  id          String   @id @default(cuid())
  accountId   String
  hashedToken String   @unique
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  // belongs to relation
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Token {
  id          String    @id @default(cuid())
  accountId   String
  type        TokenType
  hashedToken String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  // belongs to relation
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
}

model Staff {
  id          String   @id @default(cuid())
  accountId   String   @unique
  staffNumber String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // belongs to relation
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Airport {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  city             String
  country          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // has many relations
  departingFlights Flight[] @relation("origin")
  arrivingFlights  Flight[] @relation("destination")
}

model Flight {
  id                   String       @id @default(cuid())
  flightNumber         String
  originAirportId      String
  destinationAirportId String
  departureAt          DateTime
  arrivalAt            DateTime
  durationMinutes      Int
  basePrice            Decimal      @db.Decimal(10, 2)
  status               FlightStatus @default(SCHEDULED)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  // has many relations
  seats                Seat[]
  tickets              Ticket[]
  // belongs to relations
  originAirport        Airport      @relation("origin", fields: [originAirportId], references: [id])
  destinationAirport   Airport      @relation("destination", fields: [destinationAirportId], references: [id])

  @@unique([flightNumber, departureAt])
  @@index([originAirportId])
  @@index([destinationAirportId])
}

model Seat {
  id         String     @id @default(cuid())
  flightId   String
  seatRow    Int
  seatColumn String
  cabinClass CabinClass @default(ECONOMY)
  status     SeatStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // has one relation
  ticket     Ticket?
  // belongs to relation
  flight     Flight     @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, seatRow, seatColumn])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  accountId      String?
  contactEmail   String
  contactPhone   String?
  firstName      String
  lastName       String
  middleName     String?
  dateOfBirth    DateTime?
  nationality    String?
  passportNumber String?
  countryOfIssue String?
  dateOfIssue    DateTime?
  dateOfExpiry   DateTime?
  status         BookingStatus @default(PENDING)
  totalPrice     Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // has many relations
  tickets        Ticket[]
  // belongs to relation
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId])
}

model Ticket {
  id        String   @id @default(cuid())
  flightId  String
  seatId    String   @unique
  bookingId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // belongs to relations
  flight    Flight   @relation(fields: [flightId], references: [id])
  seat      Seat     @relation(fields: [seatId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([flightId])
  @@index([bookingId])
}
